; Physics Playground: gameplay uses 2D physics; presentation is collisionless 3D.
config_version=5

[application]
config/name="Sonic Spinball Runners"
run/main_scene="res://experiments/visual_lab/visual_lab.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[physics]
common/physics_ticks_per_second=120
2d/default_gravity=700.0
2d/default_linear_damp=0.0
2d/default_angular_damp=0.0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.07, 1)
