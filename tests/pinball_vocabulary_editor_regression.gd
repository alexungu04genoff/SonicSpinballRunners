extends "res://tests/authored_gimmick_editor_regression.gd"
func run() -> void:
 root.size = Vector2i(1440, 1000)
 root.gui_embed_subwindows = true
 editor = EditorScene.instantiate()
 root.add_child(editor)
 await process_frame
 editor.choose_gameplay("slingshot")
 pointer(Vector2(200, 400), true)
 pointer(Vector2(200, 400), false)
 check(editor.document.gameplay_objects.size() == 1, "Slingshot palette placement")
 editor.choose_gameplay("drop_target_bank")
 pointer(Vector2(150, 200), true)
 drag_to(Vector2(278, 200))
 pointer(Vector2(278, 200), false)
 check(editor.document.gameplay_objects.size() == 2, "Drag creates one authored bank")
 var bank: Dictionary = editor.document.gameplay_objects[1].duplicate(true)
 check(bank.properties.target_count == 5.0 and is_equal_approx(bank.properties.spacing, 32.0), "Span produces five evenly spaced targets")
 editor.undo()
 check(editor.document.gameplay_objects.size() == 1, "One undo removes entire bank")
 editor.redo()
 check(editor.document.gameplay_objects[1] == bank, "Redo restores exact bank identity")
 editor._select_mode()
 editor.canvas.select_gameplay(1)
 editor.set_gameplay_angle(37.0)
 editor.set_gameplay_property("color", "red")
 check(editor.save_to("user://pinball-editor-test.tres"), "Save authored bank")
 check(editor.load_from("user://pinball-editor-test.tres"), "Reload authored bank")
 check(editor.document.gameplay_objects[1].rotation_degrees == 37.0 and editor.document.gameplay_objects[1].properties.color == "red", "Inspector values survive reload")
 editor.free()
 quit(1 if failures else 0)
