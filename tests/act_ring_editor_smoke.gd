extends "res://tests/act_gameplay_editor_smoke.gd"
const Rings = preload("res://scripts/act_editor/ring_trails.gd")
const RING_SAVE := "res://test-results/act-ring-editor.tres"

func ring_tool() -> void:
	await click_control(editor.buttons.rings)

func run() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://test-results"))
	root.gui_embed_subwindows = true
	editor = EditorScene.instantiate()
	root.add_child(editor)
	await process_frame
	await process_frame
	if OS.get_cmdline_user_args().has("--reload-ring-editor"):
		check(editor.load_from(RING_SAVE), "Fresh editor loads trail document")
		check(editor.document.fingerprint() == OS.get_cmdline_user_args()[-1], "Fresh editor restores exact authored trail coordinates")
		await click_at(local_position(editor.document.ring_trails[0].start))
		await press_key(KEY_RIGHT)
		check(editor.document.ring_trails[0].start == Vector2(150, 100), "Reopened single ring remains editable")
		editor.queue_free()
		await process_frame
		print("RESULT | Fresh ring editor | %d checks | %d failures" % [checks, failures])
		quit(0 if failures == 0 else 1)
		return
	await choose_tab(4)
	await ring_tool()
	await click_at(grid_position(Vector2(2, 2)))
	check(editor.document.ring_trails.size() == 1 and Rings.positions(editor.document.ring_trails[0]).size() == 1, "One click creates one ring")
	for endpoints in [[Vector2(2, 3), Vector2(8, 3)], [Vector2(9, 2), Vector2(9, 8)], [Vector2(2, 8), Vector2(7, 5)]]:
		var count: int = editor.undo_stack.size()
		await drag(grid_position(endpoints[0]), grid_position(endpoints[1]))
		var trail: Dictionary = editor.document.ring_trails[-1]
		check(trail.start == endpoints[0] * 50 and trail.end == endpoints[1] * 50, "Horizontal/vertical/diagonal gesture retains its endpoints")
		check(editor.undo_stack.size() == count + 1, "One trail drag adds exactly one undo step")
	var diagonal := Rings.positions(editor.document.ring_trails[-1])
	check(diagonal.size() > 2 and diagonal[1] != (diagonal[1] / 50).round() * 50, "Diagonal internal rings do not snap back to terrain intersections")
	await set_alt(true)
	await drag(local_position(Vector2(123.5, 449.25)), local_position(Vector2(407.75, 513.125)))
	var free: Dictionary = editor.document.ring_trails[-1].duplicate(true)
	await set_alt(false)
	check(close_to(free.start, Vector2(123.5, 449.25)) and close_to(free.end, Vector2(407.75, 513.125)), "Alt creates freely positioned fractional endpoints")
	check(editor.document.ring_trails[-1] == free, "Releasing Alt does not resnap the completed trail")
	await set_alt(true)
	await move_pointer(local_position(Vector2(51.25, 525.5)))
	await mouse_button(pointer, true)
	await move_pointer(local_position(Vector2(281.75, 548.25)), true)
	var pending: Dictionary = editor.canvas._ring_preview.duplicate(true)
	await set_alt(false)
	await mouse_button(pointer, false)
	check(editor.document.ring_trails[-1] == pending, "Releasing Alt before mouse-up preserves the last free preview without drift")
	await press_key(KEY_Z, true)
	var saved_count: int = editor.document.ring_trails.size()
	await press_key(KEY_Z, true)
	check(editor.document.ring_trails.size() == saved_count - 1, "Undo removes an entire trail")
	await press_key(KEY_Y, true)
	check(editor.document.ring_trails[-1] == free and editor.canvas.ring_tool, "Redo restores the exact trail and retains the drawing tool")
	await press_key(KEY_ESCAPE)
	var point: Vector2 = Rings.positions(free)[4]
	await click_at(local_position(point))
	check(editor.canvas.selected_ring_index == saved_count - 1, "Clicking any generated ring selects its whole trail")
	await set_alt(true)
	await drag(local_position(point), local_position(point + Vector2(3.25, -10.5)))
	await set_alt(false)
	var moved: Dictionary = editor.document.ring_trails[-1].duplicate(true)
	check(close_to(moved.start, free.start + Vector2(3.25, -10.5)) and close_to(moved.end, free.end + Vector2(3.25, -10.5)), "Alt-drag moves the whole group without changing its direction or spacing")
	await set_alt(true)
	await drag(local_position(moved.end), local_position(moved.end + Vector2(20.25, -35.5)))
	await set_alt(false)
	var resized: Dictionary = editor.document.ring_trails[-1].duplicate(true)
	check(resized.start == moved.start and close_to(resized.end, moved.end + Vector2(20.25, -35.5)), "Small selected endpoint handle resizes only that endpoint")
	await set_alt(true)
	await drag(local_position(resized.start), local_position(resized.start + Vector2(-12.25, -21.5)))
	await set_alt(false)
	check(editor.document.ring_trails[-1].end == resized.end and close_to(editor.document.ring_trails[-1].start, resized.start + Vector2(-12.25, -21.5)), "Start handle adjusts the start independently of the end")
	await press_key(KEY_Z, true)
	await press_key(KEY_D, true)
	check(editor.document.ring_trails.size() == saved_count + 1 and close_to(editor.document.ring_trails[-1].start, resized.start + Vector2(50, 50)), "Duplicate copies the whole trail with its fractional offset")
	await press_key(KEY_Z, true)
	check(editor.document.ring_trails.size() == saved_count and editor.canvas.selected_ring_index == saved_count - 1, "Undo duplication restores the original selected trail")
	await press_key(KEY_DELETE)
	check(editor.document.ring_trails.size() == saved_count - 1, "Delete removes the selected trail as one group")
	await press_key(KEY_Z, true)
	check(editor.document.ring_trails[-1] == resized and editor.canvas.selected_ring_index == saved_count - 1, "Undo restores deleted trail and selection")
	await click_control(editor.ring_spacing_field.get_line_edit())
	await press_key(KEY_A, true)
	await type_text("0.5")
	await press_key(KEY_ENTER)
	check(editor.document.ring_trails[-1].spacing == 25.0, "Compact spacing field changes the selected trail")
	await click_control(editor.buttons.select)
	await choose_tab(0)
	await choose_terrain("rectangle_3x3")
	await click_at(grid_position(Vector2(3, 3)))
	await choose_tab(4)
	await ring_tool()
	await drag(grid_position(Vector2(3, 4)), grid_position(Vector2(6, 5)))
	check(editor.document.ring_trails.size() == saved_count + 1 and editor.document.placements.size() == 1, "Rings may overlap solid terrain without repair or rejection")
	await press_key(KEY_ESCAPE)
	var overlap_point: Vector2 = Rings.positions(editor.document.ring_trails[-1])[2]
	await click_at(local_position(overlap_point))
	check(editor.canvas.selected_ring_index == saved_count, "Ring trail can be selected over filled terrain")
	await set_alt(true)
	await click_at(local_position(overlap_point))
	await set_alt(false)
	check(editor.canvas.selected_index == 0, "Alt-click cycles from a ring trail to the overlapping terrain")
	await ring_tool()
	var before_cancel: int = editor.document.ring_trails.size()
	await move_pointer(grid_position(Vector2(3, 10)))
	await mouse_button(pointer, true)
	await move_pointer(grid_position(Vector2(8, 10)), true)
	await press_key(KEY_ESCAPE)
	await mouse_button(pointer, false)
	check(editor.document.ring_trails.size() == before_cancel, "Escape cancels an unfinished trail without history changes")
	check(editor.save_to(RING_SAVE), "Editor saves rings with terrain and existing authoring data")
	var expected: String = editor.document.fingerprint()
	check(editor.load_from(RING_SAVE) and editor.document.fingerprint() == expected, "Editor reload preserves every exact trail")
	var output := []
	var code := OS.execute(OS.get_executable_path(), PackedStringArray(["--headless", "--path", ProjectSettings.globalize_path("res://"), "--script", "res://tests/act_ring_editor_smoke.gd", "--", "--reload-ring-editor", expected]), output, true)
	check(code == 0, "Fresh editor process reopens and edits the saved rings")
	for line: String in output: print(line.strip_edges())
	await click_at(local_position(Rings.positions(editor.document.ring_trails[3])[4]))
	if DisplayServer.get_name() != "headless":
		await RenderingServer.frame_post_draw
		check(root.get_texture().get_image().save_png("res://test-results/act-ring-editor.png") == OK, "Rendered ring editor capture saved")
	editor.queue_free()
	await process_frame
	print("RESULT | Ring editor | %d checks | %d failures" % [checks, failures])
	quit(0 if failures == 0 else 1)
