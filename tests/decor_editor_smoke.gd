extends "res://tests/act_gameplay_editor_smoke.gd"
const Slots = preload("res://scripts/act_editor/decor_slots.gd")
const DECOR_SAVE := "res://test-results/decor-editor.tres"

func run() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://test-results"))
	root.gui_embed_subwindows = true
	editor = EditorScene.instantiate()
	root.add_child(editor)
	await process_frame
	await process_frame
	await choose_tab(3)
	check(editor.decor_list.visible, "Decor palette opens")
	for i in 4:
		await click_control(editor.buttons["decor_" + Slots.TYPES[i]])
		await click_at(local_position(Vector2(110.25 + i * 75, 215.5)))
	check(editor.document.decor_slots.size() == 4, "Palette places all four generic slot types")
	check(close_to(editor.document.decor_slots[0].position, Vector2(110.25, 215.5)), "Decor placement is free by default")
	check(editor.canvas.decor_brush.slot_type == "landmark", "Placement tool remains active")
	await press_key(KEY_ESCAPE)
	await click_at(local_position(editor.document.decor_slots[0].position))
	check(editor.canvas.selected_decor_index == 0 and not editor.buttons.delete.disabled, "Marker selects and enables editing")
	check(editor.decor_variant_field.item_count == 4 and editor.decor_variant_field.get_item_text(1).contains("Flower") and editor.decor_variant_field.get_item_text(3).contains("Grass Tuft"), "Green Hill inspector shows Auto and all three friendly small-prop variants")
	var variant_history: int = editor.undo_stack.size()
	editor.decor_variant_field.select(2)
	editor.decor_variant_field.item_selected.emit(2)
	check(editor.document.decor_slots[0].variant_mode == "fixed" and editor.document.decor_slots[0].variant_index == 1 and editor.undo_stack.size() == variant_history + 1, "Manual variant saves a generic index in one undo step")
	editor.undo()
	check(editor.document.decor_slots[0].variant_mode == "auto" and not editor.document.decor_slots[0].has("variant_index"), "Undo restores default Auto without an index")
	editor.redo()
	check(editor.document.decor_slots[0].variant_index == 1, "Redo restores the fixed index")
	var variant_fingerprint: String = editor.document.fingerprint()
	editor.decor_theme_field.select(1)
	editor.decor_theme_field.item_selected.emit(1)
	check(editor.document.fingerprint() == variant_fingerprint and editor.decor_variant_field.get_item_text(2).contains("Valve"), "Preview theme changes labels without changing the Act")
	# Medium/edge still has three Chemical Plant choices and two Green Hill choices.
	editor.decor_type_field.select(1)
	editor.decor_type_field.item_selected.emit(1)
	editor.decor_hint_field.select(1)
	editor.decor_hint_field.item_selected.emit(1)
	editor.decor_variant_field.select(3)
	editor.decor_variant_field.item_selected.emit(3)
	editor.decor_theme_field.select(0)
	editor.decor_theme_field.item_selected.emit(0)
	check(editor.document.decor_slots[0].variant_index == 2 and editor.decor_info.text.contains("unavailable") and editor.decor_variant_field.get_item_text(editor.decor_variant_field.selected).contains("unavailable"), "Unavailable index remains editable with a visible Auto fallback warning")
	editor.decor_type_field.select(0)
	editor.decor_type_field.item_selected.emit(0)
	check(editor.document.decor_slots[0].variant_index == 2 and not editor.decor_info.text.contains("unavailable") and editor.decor_variant_field.get_item_text(editor.decor_variant_field.selected).contains("Grass Tuft"), "Small Variant 3 now resolves to the grass tuft and clears the warning")
	editor.decor_hint_field.select(2)
	editor.decor_hint_field.item_selected.emit(2)
	editor.decor_variant_field.select(1)
	editor.decor_variant_field.item_selected.emit(1)
	check(editor.document.decor_slots[0].variant_index == 0 and not editor.decor_info.text.contains("unavailable"), "Choosing an available variant clears the warning")
	var id: String = editor.document.decor_slots[0].slot_id
	var from: Vector2 = editor.document.decor_slots[0].position
	var history: int = editor.undo_stack.size()
	await drag(local_position(from), local_position(from + Vector2(13.25, 7.5)))
	check(close_to(editor.document.decor_slots[0].position, from + Vector2(13.25, 7.5)) and editor.undo_stack.size() == history + 1, "Free drag preserves exact offset as one undo edit")
	await press_key(KEY_Z, true)
	check(editor.document.decor_slots[0].position == from and editor.canvas.selected_decor_index == 0, "Undo restores decor and selection")
	await press_key(KEY_Y, true)
	var moved: Vector2 = editor.document.decor_slots[0].position
	await click_control(editor.angle_field)
	await press_key(KEY_A, true)
	await type_text("37.125")
	await press_key(KEY_ENTER)
	check(editor.document.decor_slots[0].rotation_degrees == 37.125, "Angle field supports non-quarter-turn rotation")
	await press_key(KEY_R)
	await press_key(KEY_R, false, true)
	check(editor.document.decor_slots[0].rotation_degrees == 37.125, "R and Shift+R adjust decor by opposite 15-degree steps")
	editor.decor_hint_field.select(1)
	editor.decor_hint_field.item_selected.emit(1)
	editor.decor_type_field.select(2)
	editor.decor_type_field.item_selected.emit(2)
	editor.decor_scale_field.value = 1.1
	check(editor.document.decor_slots[0].placement_hint == "edge" and editor.document.decor_slots[0].slot_type == "large" and editor.document.decor_slots[0].scale == 1.1, "Inspector edits hint, type and safe scale")
	await click_control(editor.decor_position_fields[0])
	await press_key(KEY_A, true)
	await type_text("123.75")
	await press_key(KEY_ENTER)
	check(editor.document.decor_slots[0].position.x == 123.75, "Inspector edits exact local position")
	await press_key(KEY_D, true)
	check(editor.document.decor_slots.size() == 5 and editor.document.decor_slots[-1].slot_id != id and editor.document.decor_slots[-1].rotation_degrees == 37.125, "Ctrl+D duplicates transform with a fresh stable identity")
	await press_key(KEY_DELETE)
	check(editor.document.decor_slots.size() == 4, "Delete removes the selected decor slot")
	await press_key(KEY_Z, true)
	check(editor.document.decor_slots.size() == 5 and editor.canvas.selected_decor_index == 4, "Undo restores deleted decor and selection")
	await click_control(editor.decor_visible_field)
	check(not editor.canvas.show_decor and editor.canvas.mixed_hit_indices_at(editor.canvas.local_pixels_to_screen(editor.document.decor_slots[0].position)).is_empty(), "Hidden slots cannot intercept selection")
	await click_control(editor.decor_visible_field)
	await click_at(local_position(editor.document.decor_slots[0].position))
	await press_key(KEY_RIGHT)
	check(editor.document.decor_slots[0].position.x == 124.75, "Free decor arrows nudge one pixel")
	await click_control(editor.decor_snap_field)
	await click_control(editor.buttons.decor_medium)
	await click_at(local_position(Vector2(421.25, 318.5)))
	check(editor.document.decor_slots[-1].position == Vector2(400, 300), "Optional decor grid snapping works")
	await set_alt(true)
	await click_at(local_position(Vector2(462.25, 318.5)))
	await set_alt(false)
	check(close_to(editor.document.decor_slots[-1].position, Vector2(462.25, 318.5)), "Alt temporarily frees decor snap")
	await press_key(KEY_ESCAPE)
	await click_at(local_position(editor.document.decor_slots[-1].position))
	var original: Vector2 = editor.document.decor_slots[-1].position
	await move_pointer(local_position(original))
	await mouse_button(pointer, true)
	await move_pointer(local_position(original + Vector2(30, 0)), true)
	await press_key(KEY_ESCAPE)
	await mouse_button(pointer, false)
	check(editor.document.decor_slots[-1].position == original, "Escape cancels a decor drag")
	check(editor.save_to(DECOR_SAVE), "Editor saves decor with shared document workflow")
	var fingerprint: String = editor.document.fingerprint()
	check(editor.load_from(DECOR_SAVE) and editor.document.fingerprint() == fingerprint, "Editor reload preserves all decor properties")
	if DisplayServer.get_name() != "headless":
		editor.load_from("res://data/acts/decor_terraces.tres")
		await choose_tab(3)
		editor.canvas.select_decor(1)
		editor._refresh()
		await process_frame
		await RenderingServer.frame_post_draw
		check(root.get_texture().get_image().save_png("res://test-results/decor-editor.png") == OK, "Decor editor capture saved")
	editor.free()
	await process_frame
	print("RESULT | Decor editor | %d checks | %d failures" % [checks, failures])
	quit(0 if failures == 0 else 1)
